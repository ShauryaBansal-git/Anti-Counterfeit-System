# RPC endpoint for the Sepolia testnet (Alchemy, Infura, or another provider)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployer wallet private key (NEVER commit a real key). No 0x prefix required.
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# Etherscan API key, used for contract verification on Sepolia
ETHERSCAN_API_KEY=your_etherscan_api_key
